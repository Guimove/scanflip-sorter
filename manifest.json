{
  "manifest_version": 3,
  "name": "ScanFlip Sorter",
  "version": "1.3",
  "description": "Trie les extensions et groupe les cartes en pages de classeur sur ScanFlip (Yu-Gi-Oh!, Pokémon)",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://www.scanflip.fr/*",
    "https://scanflip.fr/*"
  ]
}
